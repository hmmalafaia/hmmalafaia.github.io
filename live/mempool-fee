<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: transparent;
      font-family: 'Segoe UI', Roboto, sans-serif;
      display: flex;
      gap: 32px;
      color: #ffffff;
    }
    .fee-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 140px; /* Ajuste essa largura se os números ficarem desalinhados no seu layout */
    }
    .value-container {
      display: flex;
      align-items: baseline;
      gap: 4px;
    }
    .value {
      font-size: 28px;
      font-weight: 800;
      color: #ffffff;
      text-shadow: 0 0 10px rgba(255, 153, 0, 0.5);
    }
    .unit {
      font-size: 14px;
      font-weight: 600;
      color: #ff9900;
    }
  </style>
</head>
<body>

  <!-- Baixa Prioridade -->
  <div class="fee-card">
    <div class="value-container">
      <span id="low-fee" class="value">--</span>
      <span class="unit">sat/vB</span>
    </div>
  </div>

  <!-- Média Prioridade -->
  <div class="fee-card">
    <div class="value-container">
      <span id="med-fee" class="value">--</span>
      <span class="unit">sat/vB</span>
    </div>
  </div>

  <!-- Alta Prioridade -->
  <div class="fee-card">
    <div class="value-container">
      <span id="high-fee" class="value">--</span>
      <span class="unit">sat/vB</span>
    </div>
  </div>

  <script>
    async function updateMempoolFees() {
      try {
        const response = await fetch('https://mempool.space/api/v1/fees/mempool-blocks');
        const blocks = await response.json();

        // Pega a taxa dos próximos 3 blocos. Se não houver, assume 1.0
        const highFee = blocks.length > 0 ? blocks[0].medianFee : 1.0;
        const medFee  = blocks.length > 1 ? blocks[1].medianFee : 1.0;
        const lowFee  = blocks.length > 2 ? blocks[2].medianFee : 1.0;

        // Substitui os valores na tela forçando 1 casa decimal (ex: 1.0, 1.4)
        document.getElementById('high-fee').innerText = highFee.toFixed(1);
        document.getElementById('med-fee').innerText  = medFee.toFixed(1);
        document.getElementById('low-fee').innerText  = lowFee.toFixed(1);
        
      } catch (error) {
        console.error("Erro ao buscar blocos da Mempool:", error);
      }
    }

    // O EventListener garante que o HTML carregou completamente antes de rodar o script
    document.addEventListener("DOMContentLoaded", () => {
      updateMempoolFees();
      setInterval(updateMempoolFees, 10000); // Atualiza a cada 10 segundos
    });
  </script>
</body>
</html>
